PORT=9999

# --- Kết nối Postgres ----------------------------------------------------------
# CÁCH 1 (ưu tiên): một chuỗi kết nối duy nhất. Đây là thứ Supabase/Neon phát cho bạn.
# Đặt DATABASE_URL thì mọi biến DB_* bên dưới bị bỏ qua hoàn toàn.
#
# Với Supabase: lấy biến POSTGRES_URL_NON_POOLING — SESSION POOLER, cổng 5432.
# ĐỪNG lấy POSTGRES_URL / POSTGRES_PRISMA_URL (cổng 6543, transaction pooler): backend
# chạy LISTEN/NOTIFY (services/notificationBus.js), mà ở transaction mode kết nối bị trả
# lại pool ngay sau câu lệnh nên đăng ký LISTEN rơi vào một backend ngẫu nhiên. Kết nối
# vẫn thành công, LISTEN vẫn trả OK, rồi thông báo realtime mất sạch trong im lặng.
# Host direct db.<ref>.supabase.co thường không resolve được từ mạng ngoài.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# CÁCH 2: khai báo rời, dùng cho Postgres local và cho Cloud SQL qua unix socket.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SEP490
DB_USER=postgres
DB_PASSWORD=root
# DB_SSL: bỏ trống thì tự suy ra — bật TLS cho host từ xa, tắt cho localhost.
# Chỉ đặt tay khi cần ép ngược lại.
DB_SSL=false

JWT_SECRET=MY_SECRET_KEY
# JWT_ACCESS_EXPIRES_IN=1h    # KHUYẾN NGHỊ 1h cho app mobile (mặc định prod 15m — refresh
#                              quá thường, dễ dính cold start Cloud Run). Dev default 8h.
# JWT_REFRESH_EXPIRES_IN=7d
# Cookie access/refresh và hạn refresh token lưu trong DB tự bám theo 2 giá trị trên,
# không cần chỉnh riêng. Để test nhanh luồng refresh, đặt VD: JWT_ACCESS_EXPIRES_IN=2m, JWT_REFRESH_EXPIRES_IN=10m.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Bắt buộc set trên production (Cloud Run env var) — liệt kê đủ domain FE, phân cách bởi dấu phẩy.
# Không set = chặn hết mọi origin ở production. Ở local/dev không set thì dùng mặc định localhost.
# CORS_ORIGINS=https://logiscount.icu,https://www.logiscount.icu

# (Tuỳ chọn) Thời gian giữ kết nối keep-alive (ms). Mặc định 120000.
# Node để mặc định 5 giây, trong khi proxy đứng trước container (Render, mọi load balancer
# khác) giữ kết nối lại để dùng cho request kế tiếp. Lệch nhau ở đây sinh ra 502 lẻ tẻ do
# CHÍNH PROXY trả về — log ứng dụng sạch bóng, không 500, không stack. Chỉ hạ xuống khi
# biết chắc proxy phía trước giữ kết nối ngắn hơn.
# SERVER_KEEPALIVE_TIMEOUT_MS=120000


# ─── Đọc hóa đơn bằng AI (Google Gemini — có free tier) ──────────────────────
# API key của Google Gemini. Lấy MIỄN PHÍ tại: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
#
# Chưa set = tính năng tự tắt: hóa đơn không bị chặn, nhưng mọi khoản đều rơi vào
# "cần người duyệt xem" thay vì được đánh dấu hợp lệ.
#
# (Tuỳ chọn) Đổi model đọc hóa đơn. Mặc định gemini-3.6-flash.
# CỐ Ý GHIM PHIÊN BẢN, đừng dùng alias kiểu `gemini-flash-latest`: alias tự trỏ sang
# model mới khi Google chuyển hướng, nghĩa là hành vi đọc hóa đơn đổi mà không ai deploy
# gì, và cột prompt_version dùng để so độ chính xác giữa các phiên bản mất ý nghĩa.
#
# Số đo trên 7 ảnh hóa đơn thử nghiệm (tháng 8/2026), tất cả đều đọc đúng:
#   gemini-3.6-flash       6–24 giây   (mặc định — cân bằng)
#   gemini-3.5-flash-lite  ~2,2 giây   (nhanh nhất, rẻ nhất; nên đo lại với ẢNH CHỤP
#                                       THẬT trước khi chuyển sang, ảnh thử là bản in sạch)
#   gemini-2.5-*           không dùng được — Google đã ngừng cấp cho khoá mới (404)
# RECEIPT_VISION_MODEL=gemini-3.6-flash
#
# (Tuỳ chọn) Tắt lượt ĐỌC LẠI có trợ giúp OCR. Mặc định bật.
# Lượt đọc lại chỉ chạy khi kênh OCR đáng tin VÀ chỉ ra được trường cụ thể đang lệch
# với bản đọc của model — tức là chỉ tốn thêm một lần gọi API trên phần nhỏ hóa đơn
# thật sự có vấn đề. Tắt khi hạn mức API căng: hệ thống lùi về đúng một lượt đọc, các
# lớp kiểm tra khác giữ nguyên.
# RECEIPT_VISION_RECHECK=false
#
# (Tuỳ chọn) Chỉ đọc lại khi dây chuyền tốn chưa quá chừng này mili giây. Một lượt gọi
# model có thể mất tới 45 giây, mà app tài xế cắt request tải ảnh ở 120 giây (gồm cả thời
# gian đẩy ảnh qua mạng). Bước hoàn tất không bao giờ đọc lại — app cắt request đó ở 30s.
# RECEIPT_RECHECK_MAX_ELAPSED_MS=20000
#
# (Tuỳ chọn) Trần thời gian CẢ lượt đọc một ảnh hóa đơn (ms): tải ảnh + gọi model, gồm cả
# lượt đọc lại và mọi lần thử lại khi Gemini quá tải. Hết trần thì hóa đơn chỉ rơi vào "cần
# người xem", không bị chặn. Không có trần thì hóa đơn lệch trường (kích hoạt đọc lại) gặp
# lúc Gemini quá tải có thể giữ request quá hạn chờ — app tài xế báo lỗi trong khi máy chủ
# vẫn lưu ảnh, tài xế chụp lại và thành hai ảnh.
# RECEIPT_SCAN_BUDGET_MS=55000
#
# (Tuỳ chọn) Hạn TRẢ LỜI cho một request có quét hóa đơn (ms), đếm từ lúc request tới máy
# chủ. Khác trần trên ở chỗ nó tính cả đoạn đẩy ảnh lên Cloudinary — đoạn nằm ngoài dây
# chuyền quét và co giãn theo sóng của tài xế. Lượt quét chỉ được dùng phần còn lại của hạn
# này. Đặt thấp hơn hạn chờ của app tài xế (120 giây) một khoảng đủ rộng.
# RECEIPT_RESPONSE_BUDGET_MS=55000
#
# (Tuỳ chọn) Sàn của trần thời gian quét (ms): dù hạn trả lời đã bị đoạn tải ảnh ăn gần hết,
# lượt quét vẫn được chừng này. Không có sàn thì hóa đơn gửi từ nơi sóng yếu không được đọc
# lần nào.
# RECEIPT_MIN_SCAN_BUDGET_MS=20000


# ─── Quét OCR đối chiếu (Tesseract, chạy ngay trong container) ───────────────
# Không cần khoá, không gọi ra ngoài: hai tệp vie.traineddata / eng.traineddata nằm
# sẵn trong thư mục backend.
#
# OCR KHÔNG phải bộ trích xuất — nó không dựng lại được cấu trúc bảng của hóa đơn.
# Vai trò của nó là NHÂN CHỨNG ĐỘC LẬP: model sinh có thể trả về một con số hợp lý đến
# từng chữ số mà trên giấy không hề có, còn Tesseract chỉ báo cáo được hình dạng ký tự
# thật sự có trên ảnh. Nhờ vậy hệ thống trả lời được câu "con số này có trên tờ giấy
# không" — thứ mà một mình model không bao giờ tự tố cáo.
#
# Tắt đi thì hệ thống lùi về đúng hành vi cũ (một kênh đọc), không hóa đơn nào bị chặn
# thêm; chỉ mất lớp đối chiếu và độ tin cậy sẽ luôn ở mức 0,85 thay vì 1,0.
# RECEIPT_OCR_ENABLED=false
#
# (Tuỳ chọn) Ngôn ngữ. Thêm ngôn ngữ nào thì phải có tệp <lang>.traineddata tương ứng
# trong thư mục backend, nếu không worker sẽ hỏng và cả lớp OCR tự tắt.
# RECEIPT_OCR_LANGS=vie+eng
#
# (Tuỳ chọn) Chế độ phân trang Tesseract. Mặc định '3' (tự phân tích bố cục) — hợp với
# hóa đơn GTGT khổ A4 có tiêu đề, bảng, chân trang. Hóa đơn nhiệt khổ hẹp có thể hợp
# với '4' (một cột) hoặc '6' (một khối) hơn.
# RECEIPT_OCR_PSM=3
#
# (Tuỳ chọn) Trần thời gian quét (ms) và thời gian rảnh trước khi thả worker (ms).
# Trần tính TỪ LÚC GỌI, gồm cả thời gian xếp hàng sau ảnh khác — quá trần thì hóa đơn đó
# chỉ mất lớp đối chiếu OCR, tài xế không phải chờ thêm.
# Worker giữ vài chục MB RAM và mất vài trăm ms để dựng, nên giữ lại dùng cho ảnh sau
# rồi thả ra khi vắng khách.
# RECEIPT_OCR_TIMEOUT_MS=25000
# RECEIPT_OCR_IDLE_MS=120000
#
# (Tuỳ chọn) Dựng worker hỏng (thiếu/hỏng tệp traineddata) thì tạm tắt OCR chừng này ms
# rồi mới thử lại. Hỏng liên tiếp 3 lần thì tắt hẳn tới khi khởi động lại tiến trình.
# RECEIPT_OCR_RETRY_MS=300000
#
# (Tuỳ chọn) Thư mục chứa <lang>.traineddata. Mặc định là thư mục backend. tesseract.js
# được cấu hình chỉ ĐỌC ở đây (cacheMethod: 'readOnly') — mặc định của nó là xoá tệp
# traineddata khi khởi tạo hỏng.
# RECEIPT_OCR_LANG_DIR=/duong/dan/toi/tessdata
