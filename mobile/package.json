{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "start:clear": "expo start --clear",
    "start:lan": "expo start --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:all": "eas build --profile preview",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "expo lint",
    "build:prod": "eas build -p android --profile production-apk",
    "build:prod:store": "eas build -p android --profile production",
    "build:prod:ios": "eas build -p ios --profile production"
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tamagui/babel-plugin": "1.144.4",
    "@tamagui/config": "1.144.4",
    "@tamagui/core": "1.144.4",
    "@tamagui/font-inter": "1.144.4",
    "@tamagui/metro-plugin": "1.144.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.12",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.17.0",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "tamagui": "1.144.4"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jest-html-reporters": "^3.1.7",
    "react-test-renderer": "19.1.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-native-reanimated": "3.19.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|tamagui|@tamagui/.*|lucide-react-native|phosphor-react-native)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./test-report",
          "filename": "index.html",
          "openReport": false,
          "pageTitle": "G62 Mobile Test Report"
        }
      ]
    ]
  }
}
